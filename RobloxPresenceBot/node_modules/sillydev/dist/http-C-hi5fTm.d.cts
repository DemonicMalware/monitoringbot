/** Shared by the HTTP framework integrations. */

interface HttpOptions {
    /** Return `false` to leave a request out (for example health checks). */
    shouldRecord?: (method: string, route: string) => boolean;
}
interface ErrorOptions {
    /** Which errors to record. Default: those with no status, or a status of 500 or more. */
    shouldCapture?: (error: unknown) => boolean;
}

export type { ErrorOptions as E, HttpOptions as H };
