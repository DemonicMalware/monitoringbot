{
  "name": "sillydev",
  "version": "1.3.0",
  "description": "JavaScript and TypeScript client, CLI and MCP server for the Silly Development panel API, with opt-in application monitoring.",
  "keywords": [
    "sillydev",
    "silly development",
    "bot hosting",
    "api",
    "sdk",
    "mcp",
    "monitoring"
  ],
  "homepage": "https://sillydev.co.uk/docs/panel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheGamer3514/silly-development.git",
    "directory": "sdk/js"
  },
  "license": "MIT",
  "author": "Silly Development",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp.d.ts",
        "default": "./dist/mcp.js"
      },
      "require": {
        "types": "./dist/mcp.d.cts",
        "default": "./dist/mcp.cjs"
      }
    },
    "./monitoring": {
      "import": {
        "types": "./dist/monitoring.d.ts",
        "default": "./dist/monitoring.js"
      },
      "require": {
        "types": "./dist/monitoring.d.cts",
        "default": "./dist/monitoring.cjs"
      }
    },
    "./monitoring/express": {
      "import": {
        "types": "./dist/monitoring/express.d.ts",
        "default": "./dist/monitoring/express.js"
      },
      "require": {
        "types": "./dist/monitoring/express.d.cts",
        "default": "./dist/monitoring/express.cjs"
      }
    },
    "./monitoring/fastify": {
      "import": {
        "types": "./dist/monitoring/fastify.d.ts",
        "default": "./dist/monitoring/fastify.js"
      },
      "require": {
        "types": "./dist/monitoring/fastify.d.cts",
        "default": "./dist/monitoring/fastify.cjs"
      }
    },
    "./monitoring/hono": {
      "import": {
        "types": "./dist/monitoring/hono.d.ts",
        "default": "./dist/monitoring/hono.js"
      },
      "require": {
        "types": "./dist/monitoring/hono.d.cts",
        "default": "./dist/monitoring/hono.cjs"
      }
    },
    "./monitoring/discord": {
      "import": {
        "types": "./dist/monitoring/discord.d.ts",
        "default": "./dist/monitoring/discord.js"
      },
      "require": {
        "types": "./dist/monitoring/discord.d.cts",
        "default": "./dist/monitoring/discord.cjs"
      }
    },
    "./monitoring/browser": {
      "import": {
        "types": "./dist/monitoring/browser.d.ts",
        "default": "./dist/monitoring/browser.js"
      },
      "require": {
        "types": "./dist/monitoring/browser.d.cts",
        "default": "./dist/monitoring/browser.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sillydev": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate": "python3 scripts/gen-types.py",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.27.7",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
}
