# Copiá este archivo como ".env" EN EL SERVIDOR y completá los valores.
# NUNCA subas el .env real a GitHub.

# Webhook del canal de Discord donde llegan los avisos
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# Usernames de Roblox a monitorear, separados por coma
ROBLOX_USERNAMES=usuario1,usuario2

# Cookie .ROBLOSECURITY de una cuenta (mejor una cuenta secundaria) que pueda ver
# el estado de las cuentas monitoreadas. Roblox la pide para consultar presencia.
ROBLOSECURITY=

# Segundos entre consultas (mínimo 15)
POLL_INTERVAL=30

# Resumen periódico de todas las cuentas cada N minutos (0 = desactivado)
SUMMARY_INTERVAL_MIN=0

# Zona horaria de las fechas que se muestran
TIMEZONE=America/Argentina/Buenos_Aires
